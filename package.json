{
  "name": "toadstool-kingdoms",
  "private": true,
  "version": "0.1.0",
  "description": "Toadstool Kingdoms - an original cartoon-fantasy base-building and raiding game.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit",
    "server:build": "vite build --config vite.server.config.ts",
    "server:start": "node dist-server/main.js",
    "server:dev": "npm run server:build && npm run server:start",
    "sim:playthroughs": "vite build --config vite.sim.config.ts && node dist-sim/playthroughs.js",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
